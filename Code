
import java.util.Scanner;
import java.util.ArrayList;

class Workout {
    int workoutId;
    String exerciseName;
    String category;
    int duration;
    int caloriesBurned;
    boolean completed;

    Workout(int id, String name, String cat,
            int dur, int calories) {
        workoutId = id;
        exerciseName = name;
        category = cat;
        duration = dur;
        caloriesBurned = calories;
        completed = false;
    }

    void display() {
        System.out.println("-------------------------");
        System.out.println("Workout ID: " + workoutId);
        System.out.println("Exercise: " + exerciseName);
        System.out.println("Category: " + category);
        System.out.println("Duration: " + duration + " minutes");
        System.out.println("Calories Burned: " + caloriesBurned);
        System.out.println("Completed: " + completed);
    }
}

public class Main {
    static Scanner sc = new Scanner(System.in);
    static ArrayList<Workout> list = new ArrayList<>();

    static void addWorkout() {
        System.out.print("Enter Workout ID: ");
        int id = sc.nextInt();
        sc.nextLine();

        for (Workout w : list) {
            if (w.workoutId == id) {
                System.out.println("ID already exists!");
                return;
            }
        }

        System.out.print("Enter Exercise Name: ");
        String name = sc.nextLine();

        System.out.print("Enter Category: ");
        String cat = sc.nextLine();

        System.out.print("Enter Duration in minutes: ");
        int dur = sc.nextInt();

        System.out.print("Enter Calories Burned: ");
        int calories = sc.nextInt();
        sc.nextLine();

        if (dur <= 0 || calories < 0) {
            System.out.println("Invalid duration or calories!");
            return;
        }

        list.add(new Workout(id, name, cat, dur, calories));
        System.out.println("Workout added successfully!");
    }

    static void viewWorkouts() {
        if (list.isEmpty()) {
            System.out.println("No workouts available.");
            return;
        }

        for (Workout w : list) {
            w.display();
        }
    }

    static void searchWorkout() {
        System.out.print("Enter Workout ID to search: ");
        int id = sc.nextInt();
        sc.nextLine();

        for (Workout w : list) {
            if (w.workoutId == id) {
                w.display();
                return;
            }
        }

        System.out.println("Workout not found!");
    }

    static void updateWorkout() {
        System.out.print("Enter Workout ID to update: ");
        int id = sc.nextInt();
        sc.nextLine();

        for (Workout w : list) {
            if (w.workoutId == id) {
                System.out.print("Enter new Exercise Name: ");
                w.exerciseName = sc.nextLine();

                System.out.print("Enter new Category: ");
                w.category = sc.nextLine();

                System.out.print("Enter new Duration: ");
                int dur = sc.nextInt();

                System.out.print("Enter new Calories: ");
                int calories = sc.nextInt();
                sc.nextLine();

                if (dur <= 0 || calories < 0) {
                    System.out.println("Invalid values!");
                    return;
                }

                w.duration = dur;
                w.caloriesBurned = calories;

                System.out.println("Workout updated successfully!");
                return;
            }
        }

        System.out.println("Workout not found!");
    }

    static void deleteWorkout() {
        System.out.print("Enter Workout ID to delete: ");
        int id = sc.nextInt();
        sc.nextLine();

        for (int i = 0; i < list.size(); i++) {
            if (list.get(i).workoutId == id) {
                list.remove(i);
                System.out.println("Workout deleted successfully!");
                return;
            }
        }

        System.out.println("Workout not found!");
    }

    static void completeWorkout() {
        System.out.print("Enter Workout ID: ");
        int id = sc.nextInt();
        sc.nextLine();

        for (Workout w : list) {
            if (w.workoutId == id) {
                w.completed = true;
                System.out.println("Workout marked as completed!");
                return;
            }
        }

        System.out.println("Workout not found!");
    }

    static void summary() {
        int totalDuration = 0;
        int totalCalories = 0;
        int completed = 0;

        for (Workout w : list) {
            totalDuration += w.duration;
            totalCalories += w.caloriesBurned;

            if (w.completed) {
                completed++;
            }
        }

        System.out.println("\n===== FITNESS SUMMARY =====");
        System.out.println("Total Workouts: " + list.size());
        System.out.println("Completed Workouts: " + completed);
        System.out.println("Total Duration: " + totalDuration + " minutes");
        System.out.println("Total Calories: " + totalCalories);

        if (!list.isEmpty()) {
            System.out.println("Average Duration: "
                    + (double) totalDuration / list.size()
                    + " minutes");
        }
    }

    public static void main(String[] args) {
        int choice;

        do {
            System.out.println("\n===== PERSONAL FITNESS TRACKER =====");
            System.out.println("1. Add Workout");
            System.out.println("2. View Workouts");
            System.out.println("3. Search Workout");
            System.out.println("4. Update Workout");
            System.out.println("5. Delete Workout");
            System.out.println("6. Mark Workout Completed");
            System.out.println("7. Fitness Summary");
            System.out.println("8. Exit");
            System.out.print("Enter your choice: ");

            choice = sc.nextInt();
            sc.nextLine();

            switch (choice) {
                case 1:
                    addWorkout();
                    break;
                case 2:
                    viewWorkouts();
                    break;
                case 3:
                    searchWorkout();
                    break;
                case 4:
                    updateWorkout();
                    break;
                case 5:
                    deleteWorkout();
                    break;
                case 6:
                    completeWorkout();
                    break;
                case 7:
                    summary();
                    break;
                case 8:
                    System.out.println("Thank you for using the tracker!");
                    break;
                default:
                    System.out.println("Invalid choice! Try again.");
            }

        } while (choice != 8);

        sc.close();
    }
}
